{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CitoNauta: generar sitio",
      "type": "process",
      "command": "python",
      "args": [
        "scripts/generate_site.py",
        "--force",
        "--with-units"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "CitoNauta: validar currículo",
      "type": "process",
      "command": "python",
      "args": [
        "scripts/validate_curriculum.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "CitoNauta: tests",
      "type": "process",
      "command": "python",
      "args": [
        "-m",
        "unittest",
        "discover",
        "-s",
        "tests"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "CitoNauta: servidor local",
      "type": "process",
      "command": "python",
      "args": [
        "-m",
        "http.server",
        "8000"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
