{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://citonauta.org/schemas/academic/registry-v1.schema.json",
  "title": "Registros académicos auxiliares CitoNauta 1.0",
  "description": "Contrato común para glossary.json, sources.json, claims.json y media.json. La validación cruzada reside en scripts/validate_academic_courses.py.",
  "type": "object",
  "required": ["$schema", "schema_version", "course_id"],
  "properties": {
    "$schema": {"const": "../../../schemas/academic/registry-v1.schema.json"},
    "schema_version": {"const": "1.0"},
    "course_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "entries": {"type": "array"},
    "sources": {"type": "array"},
    "claims": {"type": "array"},
    "items": {"type": "array"},
    "source_policy": {"type": "string"},
    "consulted_on": {"type": ["string", "null"]},
    "coverage_gaps": {"type": "array"},
    "coverage_status": {"type": "string"},
    "content_version": {"type": ["string", "null"]},
    "content_commit": {"type": ["string", "null"]},
    "scope": {"type": "string"},
    "review_state": {"type": "string"},
    "status": {"type": "string"}
  },
  "anyOf": [
    {"required": ["entries"]},
    {"required": ["sources"]},
    {"required": ["claims"]},
    {"required": ["items"]}
  ],
  "additionalProperties": false
}
