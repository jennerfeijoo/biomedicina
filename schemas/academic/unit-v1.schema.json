{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://citonauta.org/schemas/academic/unit-v1.schema.json",
  "title": "Unidad académica canónica CitoNauta 1.0",
  "type": "object",
  "required": [
    "$schema",
    "schema_version",
    "id",
    "course_id",
    "order",
    "slug",
    "title",
    "status",
    "purpose",
    "prerequisite_unit_ids",
    "course_learning_outcome_ids",
    "learning_outcomes",
    "topics",
    "examples",
    "activities",
    "assessment_file",
    "glossary_entry_ids",
    "source_ids",
    "claim_ids",
    "media_ids",
    "common_errors",
    "biomedical_connections",
    "editorial_notice"
  ],
  "properties": {
    "$schema": {"const": "../../../../schemas/academic/unit-v1.schema.json"},
    "schema_version": {"const": "1.0"},
    "id": {"type": "string", "pattern": "^[A-Z][A-Z0-9]{2,11}-U[0-9]{2}$"},
    "course_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "order": {"type": "integer", "minimum": 1},
    "slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "title": {"type": "string", "minLength": 1},
    "status": {"$ref": "course-v1.schema.json#/$defs/status"},
    "purpose": {"type": "string", "minLength": 30},
    "prerequisite_unit_ids": {"$ref": "#/$defs/idList"},
    "course_learning_outcome_ids": {"$ref": "#/$defs/idList"},
    "learning_outcomes": {"$ref": "#/$defs/statementRecords"},
    "topics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "blocks", "subtopics"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]+-T[0-9]{2}$"},
          "title": {"type": "string", "minLength": 1},
          "key_points": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "blocks": {"$ref": "#/$defs/blocks"},
          "subtopics": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "title", "blocks"],
              "properties": {
                "id": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]+-ST[0-9]{2}$"},
                "title": {"type": "string", "minLength": 1},
                "blocks": {"$ref": "#/$defs/blocks"}
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "examples": {"type": "array", "items": {"type": "object", "required": ["id", "title", "scenario", "reasoning_steps", "interpretation", "limitations"]}},
    "activities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "purpose", "prerequisite_unit_ids", "instructions", "tasks", "deliverables", "checking_criteria", "estimated_duration_minutes", "status"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "purpose": {"type": "string", "minLength": 1},
          "prerequisite_unit_ids": {"$ref": "#/$defs/idList"},
          "instructions": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "tasks": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "deliverables": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "checking_criteria": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "estimated_duration_minutes": {"type": ["integer", "null"], "minimum": 1},
          "status": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "assessment_file": {"type": "string", "pattern": "^assessments/unit-[0-9]{2}\\.json$"},
    "glossary_entry_ids": {"$ref": "#/$defs/idList"},
    "source_ids": {"$ref": "#/$defs/idList"},
    "claim_ids": {"$ref": "#/$defs/idList"},
    "media_ids": {"$ref": "#/$defs/idList"},
    "common_errors": {"type": "array"},
    "biomedical_connections": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "editorial_notice": {"type": "string"},
    "legacy_origin": {"type": "string"}
  },
  "$defs": {
    "idList": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "statementRecords": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "statement"],
        "properties": {"id": {"type": "string", "minLength": 1}, "statement": {"type": "string", "minLength": 1}},
        "additionalProperties": false
      }
    },
    "blocks": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": ["id", "type", "text"],
            "properties": {"id": {"type": "string"}, "type": {"const": "paragraph"}, "text": {"type": "string", "minLength": 1}},
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": ["id", "type", "latex"],
            "properties": {
              "id": {"type": "string"},
              "type": {"const": "equation"},
              "latex": {"type": "string", "minLength": 1},
              "label": {"type": "string"},
              "variables": {"type": "object", "additionalProperties": {"type": "string"}}
            },
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "additionalProperties": false
}
