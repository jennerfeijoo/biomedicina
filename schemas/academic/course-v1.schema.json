{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://citonauta.org/schemas/academic/course-v1.schema.json",
  "title": "Curso académico canónico CitoNauta 1.0",
  "type": "object",
  "required": [
    "$schema",
    "schema_version",
    "id",
    "code",
    "area_id",
    "title",
    "language",
    "content_version",
    "academic_level",
    "audience",
    "status",
    "purpose",
    "scope",
    "prerequisites",
    "competencies",
    "learning_outcomes",
    "core_source_ids",
    "unit_files",
    "assessment_files",
    "registries",
    "static_site"
  ],
  "properties": {
    "$schema": {"const": "../../../schemas/academic/course-v1.schema.json"},
    "schema_version": {"const": "1.0"},
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "code": {"type": "string", "pattern": "^[A-Z][A-Z0-9]{2,11}$"},
    "area_id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "language": {"type": "string", "minLength": 2},
    "content_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "academic_level": {"type": "string", "minLength": 1},
    "audience": {"type": "string", "minLength": 1},
    "status": {"$ref": "#/$defs/status"},
    "purpose": {"type": "string", "minLength": 40},
    "scope": {
      "type": "object",
      "required": ["included", "excluded"],
      "properties": {
        "included": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "excluded": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "handoff_courses": {"type": "array", "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    },
    "prerequisites": {"$ref": "#/$defs/statementRecords"},
    "competencies": {"$ref": "#/$defs/statementRecords"},
    "learning_outcomes": {"$ref": "#/$defs/statementRecords"},
    "study_method": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "core_source_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "unit_files": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^units/unit-[0-9]{2}\\.json$"}},
    "assessment_files": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^assessments/[a-z0-9-]+\\.json$"}},
    "registries": {
      "type": "object",
      "required": ["glossary", "sources", "claims", "media"],
      "properties": {
        "glossary": {"const": "glossary.json"},
        "sources": {"const": "sources.json"},
        "claims": {"const": "claims.json"},
        "media": {"const": "media.json"}
      },
      "additionalProperties": false
    },
    "static_site": {
      "type": "object",
      "required": ["renderer", "canonical_source", "legacy_mirrors"],
      "properties": {
        "renderer": {"type": "string", "minLength": 1},
        "canonical_source": {"const": true},
        "legacy_mirrors": {"type": "array", "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    },
    "editorial_notice": {"type": "string"}
  },
  "$defs": {
    "statementRecords": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "statement"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "statement": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "status": {
      "type": "object",
      "required": ["content", "sources", "pedagogy", "multimedia", "internal_review", "external_review", "publication"],
      "properties": {
        "content": {"enum": ["not_started", "draft", "in_review", "complete"]},
        "sources": {"enum": ["not_started", "partial", "traceable", "verified"]},
        "pedagogy": {"enum": ["not_started", "draft", "in_review", "complete"]},
        "multimedia": {"enum": ["not_started", "planned", "partial", "complete"]},
        "internal_review": {"enum": ["pending", "in_progress", "approved", "changes_requested"]},
        "external_review": {"enum": ["pending", "in_progress", "approved", "changes_requested"]},
        "publication": {"enum": ["not_published", "published_provisional", "published_reviewed"]}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
