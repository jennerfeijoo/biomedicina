{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://citonauta.org/schemas/academic/assessment-v1.schema.json",
  "title": "Evaluación académica canónica CitoNauta 1.0",
  "oneOf": [
    {"$ref": "#/$defs/unitAssessment"},
    {"$ref": "#/$defs/courseAssessment"}
  ],
  "$defs": {
    "unitAssessment": {
      "type": "object",
      "required": ["$schema", "schema_version", "id", "course_id", "scope", "unit_id", "purpose", "student_payload_policy", "items", "status"],
      "properties": {
        "$schema": {"const": "../../../../schemas/academic/assessment-v1.schema.json"},
        "schema_version": {"const": "1.0"},
        "id": {"type": "string", "minLength": 1},
        "course_id": {"type": "string", "minLength": 1},
        "scope": {"const": "unit"},
        "unit_id": {"type": "string", "minLength": 1},
        "purpose": {"type": "string", "minLength": 1},
        "student_payload_policy": {"type": "string", "minLength": 1},
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "type", "prompt", "linked_learning_outcome_ids", "difficulty", "cognitive_level", "answer_key", "feedback", "source_ids", "status"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "type": {"enum": ["single_choice", "multiple_choice", "short_answer", "numeric", "case_analysis", "practical"]},
              "prompt": {"type": "string", "minLength": 1},
              "linked_learning_outcome_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
              "difficulty": {"enum": ["unclassified", "foundational", "intermediate", "advanced"]},
              "cognitive_level": {"enum": ["unclassified", "remember", "understand", "apply", "analyze", "evaluate", "create"]},
              "answer_key": {
                "type": "object",
                "required": ["expected_answer", "explanation", "common_misconceptions"],
                "properties": {
                  "expected_answer": {"type": "string", "minLength": 1},
                  "explanation": {"type": ["string", "null"]},
                  "common_misconceptions": {"type": "array", "items": {"type": "string"}}
                },
                "additionalProperties": false
              },
              "feedback": {
                "type": "object",
                "required": ["correct", "incorrect"],
                "properties": {"correct": {"type": ["string", "null"]}, "incorrect": {"type": ["string", "null"]}},
                "additionalProperties": false
              },
              "source_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
              "status": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          }
        },
        "status": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "courseAssessment": {
      "type": "object",
      "required": ["$schema", "schema_version", "id", "course_id", "scope", "principles", "assessment_plan", "diagnostic", "midterm_blueprint", "capstone", "status"],
      "properties": {
        "$schema": {"const": "../../../../schemas/academic/assessment-v1.schema.json"},
        "schema_version": {"const": "1.0"},
        "id": {"type": "string", "minLength": 1},
        "course_id": {"type": "string", "minLength": 1},
        "scope": {"const": "course"},
        "principles": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "assessment_plan": {"type": "array", "minItems": 1},
        "diagnostic": {"type": "object"},
        "midterm_blueprint": {"type": "array"},
        "capstone": {"type": "object"},
        "status": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  }
}
