  "practices": [
    {
      "id": "U6-P1",
      "title": "Mapa sintético de rutas de corriente y barreras",
      "objective": "Representar fuente, impedancias, trayectoria, nodo de referencia y barreras sin convertir el modelo en evidencia de seguridad.",
      "inputs": {
        "source_voltage_v_rms": 5.0,
        "path_impedance_ohm": 10000000.0,
        "barriers": ["separación funcional", "barrera conceptual de aislamiento"]
      },
      "deterministic_result": {
        "path_current_a_rms": 0.0000005,
        "path_current_uA_rms": 0.5
      },
      "student_tasks": [
        "dibujar la trayectoria completa de corriente",
        "distinguir referencia de señal, tierra de protección y blindaje",
        "identificar qué afirmaciones no pueden deducirse del cálculo"
      ],
      "acceptance_criteria": [
        "usa I=V/Z con unidades coherentes",
        "nombra todos los nodos y retornos",
        "declara que el resultado no prueba conformidad ni seguridad"
      ]
    },
    {
      "id": "U6-P2",
      "title": "Clasificación reproducible de mecanismos de acoplamiento EMC",
      "objective": "Calcular y comparar acoplamiento conducido, capacitivo, inductivo y radiado con parámetros explícitos.",
      "cases": [
        {
          "mechanism": "conducido",
          "equation": "V_error = I_interference * Z_common",
          "parameters": {"I_interference_a_rms": 0.002, "Z_common_ohm": 4.0},
          "expected_output_v_rms": 0.008
        },
        {
          "mechanism": "capacitivo",
          "equation": "I_c = 2*pi*f*C_mutual*V_source",
          "parameters": {"frequency_hz": 50.0, "C_mutual_f": 1e-10, "V_source_v_rms": 230.0},
          "expected_output_a_rms": 7.225663103256524e-06
        },
        {
          "mechanism": "inductivo",
          "equation": "V_induced = 2*pi*f*M*I_source",
          "parameters": {"frequency_hz": 1000.0, "mutual_inductance_h": 2e-6, "I_source_a_rms": 0.1},
          "expected_output_v_rms": 0.0012566370614359172
        },
        {
          "mechanism": "radiado",
          "equation": "V_victim = coupling_gain * V_source",
          "parameters": {"coupling_gain": 0.0002, "V_source_v_rms": 10.0},
          "expected_output_v_rms": 0.002
        }
      ],
      "student_tasks": [
        "identificar fuente, víctima y trayectoria",
        "recalcular cada salida",
        "proponer una mitigación conceptual por mecanismo",
        "explicar por qué el cálculo no constituye un ensayo EMC"
      ]
    },
    {
      "id": "U6-P3",
      "title": "Análisis sintético de fallo simple",
      "objective": "Comparar estado nominal y un fallo simple en un modelo no clínico y no energizado.",
      "scenario": {
        "nominal": {"source_voltage_v_rms": 5.0, "path_impedance_ohm": 10000000.0, "expected_current_uA_rms": 0.5},
        "single_fault": {"source_voltage_v_rms": 5.0, "path_impedance_ohm": 1000000.0, "expected_current_uA_rms": 5.0}
      },
      "student_tasks": [
        "calcular ambos estados",
        "cuantificar el cambio relativo",
        "identificar la barrera degradada",
        "separar peligro, situación peligrosa, daño posible y evidencia faltante"
      ],
      "acceptance_criteria": [
        "resultado nominal de 0.5 uA",
        "resultado de fallo de 5.0 uA",
        "factor de incremento igual a 10",
        "sin comparación con límites regulatorios no documentados"
      ]
    }
  ],
