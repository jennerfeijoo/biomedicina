        {
          "source_id": "bipm-vim-measurement-model",
          "locator": "VIM3 entry 2.48 and notes"
        }
      ]
    },
    {
      "id": "BIOINST-GLO-011",
      "term": "Calibración",
      "definition": "Operación que, bajo condiciones especificadas, establece una relación entre valores de referencia con sus incertidumbres y las indicaciones correspondientes, y luego usa esa relación para obtener un resultado desde una indicación.",
