      "source_locators": [
        {
          "source_id": "bipm-vim-calibration",
          "locator": "VIM3 entry 2.39 and notes"
        }
      ]
    },
    {
      "id": "BIOINST-GLO-012",
      "term": "Trazabilidad metrológica",
      "definition": "Propiedad de un resultado de medición por la que puede relacionarse con una referencia mediante una cadena documentada e ininterrumpida de calibraciones, cada una contribuyendo a la incertidumbre.",
      "unit_ids": [
        "BIOINST-U01"
