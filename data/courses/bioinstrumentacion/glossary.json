      "source_locators": [
        {
          "source_id": "bipm-vim-traceability",
          "locator": "VIM3 entry 2.41 and notes 1–8"
        }
      ]
    },
    {
      "id": "BIOINST-GLO-015",
      "term": "Interfaz",
      "definition": "Zona o conjunto de mecanismos por los que se transfiere energía o información entre el objeto y el sistema, con posibilidad de introducir carga o influencias.",
      "unit_ids": [
        "BIOINST-U10",
        "BIOINST-U02"
