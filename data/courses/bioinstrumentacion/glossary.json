  "entries": [
    {
      "id": "BIOINST-GLO-001",
      "term": "Mensurando",
      "definition": "Cantidad que se pretende medir, especificada con el detalle necesario para el uso previsto.",
      "unit_ids": [
        "BIOINST-U01"
      ],
      "source_ids": [
        "bipm-vim-measurand"
      ],
      "verification_status": "verified_directly",
      "source_locators": [
        {
          "source_id": "bipm-vim-measurand",
          "locator": "VIM3 entry 2.3 and notes"
        }
      ]
    },
    {
      "id": "BIOINST-GLO-002",
      "term": "Cantidad",
      "definition": "Propiedad de un fenómeno, cuerpo o sustancia cuya magnitud puede expresarse mediante un número y una referencia.",
      "unit_ids": [
        "BIOINST-U01"
      ],
      "source_ids": [
        "bipm-vim-quantity"
      ],
      "verification_status": "verified_directly",
      "source_locators": [
        {
          "source_id": "bipm-vim-quantity",
          "locator": "VIM3 entry 1.1 and notes"
        }
      ]
    },
    {
      "id": "BIOINST-GLO-003",
      "term": "Fenómeno",
      "definition": "Proceso o estado del sistema biológico que genera, porta o modifica cantidades observables; se usa aquí como categoría didáctica distinta de la cantidad y de la señal.",
      "unit_ids": [
        "BIOINST-U01"
      ],
      "source_ids": [
        "bipm-vim-quantity"
      ],
      "verification_status": "verified_contextually",
      "source_locators": [
        {
          "source_id": "bipm-vim-quantity",
          "locator": "VIM3 entry 1.1; quantity is a property of a phenomenon, body or substance"
        }
      ]
    },
    {
      "id": "BIOINST-GLO-004",
      "term": "Señal",
      "definition": "Representación física o digital que recorre una ruta de la cadena y transporta información sobre una interacción; no equivale por sí sola al mensurando ni al resultado.",
      "unit_ids": [
        "BIOINST-U01"
      ],
      "source_ids": [
        "bipm-vim-measuring-chain",
        "physionet-mit-bih-arrhythmia"
      ],
      "verification_status": "verified_contextually",
      "source_locators": [
        {
          "source_id": "bipm-vim-measuring-chain",
          "locator": "VIM3 entry 3.10"
        },
        {
          "source_id": "physionet-mit-bih-arrhythmia",
          "locator": "record header and Data Description"
        }
      ]
    },
    {
      "id": "BIOINST-GLO-005",
      "term": "Indicación",
      "definition": "Valor de cantidad proporcionado por un instrumento o sistema de medición; puede pertenecer a una clase de cantidad distinta de la cantidad medida.",
      "unit_ids": [
        "BIOINST-U01"
      ],
      "source_ids": [
        "bipm-vim-indication"
      ],
      "verification_status": "verified_directly",
      "source_locators": [
        {
          "source_id": "bipm-vim-indication",
          "locator": "VIM3 entry 4.1 and notes"
        }
      ]
    },
    {
      "id": "BIOINST-GLO-006",
      "term": "Valor medido",
      "definition": "Valor de cantidad que representa un resultado de medición y se atribuye al mensurando a partir de la información disponible.",
      "unit_ids": [
        "BIOINST-U01"
      ],
      "source_ids": [
        "bipm-vim-measured-value"
      ],
      "verification_status": "verified_directly",
      "source_locators": [
        {
          "source_id": "bipm-vim-measured-value",
          "locator": "VIM3 entry 2.10 and notes"
        }
      ]
    },
    {
      "id": "BIOINST-GLO-007",
      "term": "Resultado de medición",
      "definition": "Conjunto de valores de cantidad atribuidos al mensurando junto con la información relevante disponible para interpretarlos, normalmente incluida la incertidumbre.",
      "unit_ids": [
        "BIOINST-U01"
      ],
      "source_ids": [
        "bipm-vim-measurement-result"
      ],
      "verification_status": "verified_directly",
      "source_locators": [
        {
          "source_id": "bipm-vim-measurement-result",
          "locator": "VIM3 entry 2.9 and notes"
        }
      ]
    },
    {
      "id": "BIOINST-GLO-008",
      "term": "Sistema de medición",
      "definition": "Conjunto de uno o más instrumentos y, con frecuencia, otros dispositivos o suministros ensamblados para generar información usada al obtener valores medidos.",
      "unit_ids": [
        "BIOINST-U01"
      ],
      "source_ids": [
        "bipm-vim-measuring-system"
      ],
      "verification_status": "verified_directly",
      "source_locators": [
        {
          "source_id": "bipm-vim-measuring-system",
          "locator": "VIM3 entry 3.2 and notes"
        }
      ]
    },
    {
      "id": "BIOINST-GLO-009",
      "term": "Cadena de medición",
      "definition": "Serie de elementos de un sistema de medición que constituye una única ruta de señal desde un sensor hasta un elemento de salida.",
      "unit_ids": [
        "BIOINST-U01"
      ],
      "source_ids": [
        "bipm-vim-measuring-chain"
      ],
      "verification_status": "verified_directly",
      "source_locators": [
        {
          "source_id": "bipm-vim-measuring-chain",
          "locator": "VIM3 entry 3.10 and examples"
        }
      ]
    },
    {
      "id": "BIOINST-GLO-010",
      "term": "Modelo de medición",
      "definition": "Relación matemática entre todas las cantidades conocidas que intervienen en una medición, con el mensurando como cantidad de salida.",
      "unit_ids": [
        "BIOINST-U01"
      ],
      "source_ids": [
        "bipm-vim-measurement-model"
