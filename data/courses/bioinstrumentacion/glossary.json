        {
          "source_id": "jcgm-gum-6-2020",
          "locator": "JCGM GUM-6:2020 clauses 5.6–6.6"
        }
      ]
    },
    {
      "id": "BIOINST-GLO-021",
      "term": "Deriva",
      "definition": "Cambio lento de una característica o salida con el tiempo bajo condiciones nominalmente constantes, distinguible de ruido y de dependencia de trayectoria.",
