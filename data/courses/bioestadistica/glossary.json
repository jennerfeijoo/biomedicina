  "entries": [
    {
      "id": "BIOEST-GLO-001",
      "term": "Estimando",
      "definition": "Cantidad poblacional definida por la pregunta científica que se pretende estimar; en un ensayo clínico su especificación articula población, condición de tratamiento, variable de desenlace, estrategia para eventos intercurrentes y medida resumen poblacional.",
      "unit_ids": [
        "BIOEST-U01"
      ],
      "source_ids": [
        "ich-e9-r1-estimands"
      ],
      "source_locators": [
        {
          "source_id": "ich-e9-r1-estimands",
          "locator": "Sections A.2–A.3, document pp. 5–7"
        }
      ],
      "verification_status": "verified_directly"
    },
    {
      "id": "BIOEST-GLO-002",
      "term": "Población objetivo",
      "definition": "Conjunto de unidades sobre el que se formula la pregunta y al que se pretende aplicar la inferencia; debe distinguirse de la población efectivamente alcanzable y de la muestra observada.",
      "unit_ids": [
        "BIOEST-U01"
      ],
      "source_ids": [
        "openintro-ims-2e"
      ],
      "source_locators": [
        {
          "source_id": "openintro-ims-2e",
          "locator": "Section 2.1.1, Populations and samples, printed pp. 28–31"
        }
      ],
      "verification_status": "verified_directly"
    },
    {
      "id": "BIOEST-GLO-003",
      "term": "Población accesible",
      "definition": "Conjunto de unidades que el estudio puede identificar y reclutar de acuerdo con su entorno, periodo, criterios de elegibilidad y procedimientos de selección.",
      "unit_ids": [
        "BIOEST-U01"
      ],
      "source_ids": [
        "strobe-statement-checklists"
      ],
      "source_locators": [
        {
          "source_id": "strobe-statement-checklists",
          "locator": "Checklist items 5–6 and 13: setting, eligibility, selection and participant flow"
        }
      ],
      "verification_status": "verified_directly"
    },
    {
      "id": "BIOEST-GLO-004",
      "term": "Marco muestral",
      "definition": "Lista, registro o mecanismo operativo que identifica las unidades elegibles desde las que se selecciona una muestra; su cobertura condiciona qué miembros de la población pueden ser incluidos.",
      "unit_ids": [
        "BIOEST-U01"
      ],
      "source_ids": [
        "openintro-ims-2e"
      ],
      "source_locators": [
        {
          "source_id": "openintro-ims-2e",
          "locator": "Section 2.1, Sampling principles and strategies, printed pp. 28–33"
        }
      ],
      "verification_status": "verified_directly"
    },
    {
      "id": "BIOEST-GLO-005",
      "term": "Unidad de análisis",
      "definition": "Entidad elemental sobre la que se registran o resumen variables y a la que se refiere la inferencia estadística; no debe confundirse con cada medición repetida ni con una réplica técnica.",
      "unit_ids": [
        "BIOEST-U01"
      ],
      "source_ids": [
        "openintro-ims-2e"
      ],
      "source_locators": [
        {
          "source_id": "openintro-ims-2e",
          "locator": "Chapter 1, observations and variables, printed pp. 12–14; section 2.2, experimental units and pseudoreplication, printed p. 34"
        }
      ],
      "verification_status": "verified_directly"
    },
    {
      "id": "BIOEST-GLO-006",
      "term": "Variable continua",
      "definition": "Variable cuantitativa que, dentro de su dominio de medición, puede tomar cualquier valor de un intervalo, aunque el instrumento registre una precisión finita.",
      "unit_ids": [
        "BIOEST-U01"
      ],
      "source_ids": [
        "openintro-ims-2e"
      ],
      "source_locators": [
        {
          "source_id": "openintro-ims-2e",
          "locator": "Section 1.2, Types of variables, printed pp. 14–15"
        }
      ],
      "verification_status": "verified_directly"
    },
    {
      "id": "BIOEST-GLO-007",
      "term": "Variable ordinal",
      "definition": "Variable categórica cuyas categorías poseen un orden significativo, sin que las distancias entre categorías deban ser iguales o cuantificables.",
      "unit_ids": [
        "BIOEST-U01"
      ],
      "source_ids": [
        "openintro-ims-2e"
      ],
      "source_locators": [
        {
          "source_id": "openintro-ims-2e",
          "locator": "Section 1.2, Types of variables, printed pp. 14–15"
        }
      ],
      "verification_status": "verified_directly"
    },
    {
      "id": "BIOEST-GLO-008",
      "term": "Exposición",
      "definition": "Característica, condición o intervención cuya relación con uno o más desenlaces se investiga; su definición operativa debe especificar fuente, método y momento de medición.",
      "unit_ids": [
        "BIOEST-U01"
      ],
      "source_ids": [
        "strobe-statement-checklists"
      ],
      "source_locators": [
        {
          "source_id": "strobe-statement-checklists",
          "locator": "Checklist items 7–8: definition of exposures and data sources or measurement methods"
        }
      ],
      "verification_status": "verified_directly"
    },
    {
      "id": "BIOEST-GLO-009",
      "term": "Desenlace",
      "definition": "Resultado o evento cuya ocurrencia, valor o tiempo hasta aparición se pretende describir o comparar; debe definirse operacionalmente antes de interpretarlo.",
      "unit_ids": [
        "BIOEST-U01"
      ],
      "source_ids": [
        "strobe-statement-checklists"
      ],
      "source_locators": [
        {
          "source_id": "strobe-statement-checklists",
          "locator": "Checklist items 7–8: definition of outcomes and data sources or measurement methods"
        }
      ],
      "verification_status": "verified_directly"
    },
    {
      "id": "BIOEST-GLO-010",
      "term": "Confusor",
      "definition": "Variable asociada con la exposición y el desenlace que no es consecuencia de la exposición y que, si no se controla apropiadamente, puede distorsionar la asociación de interés.",
      "unit_ids": [
        "BIOEST-U01"
      ],
      "source_ids": [
        "openintro-ims-2e"
      ],
      "source_locators": [
        {
          "source_id": "openintro-ims-2e",
          "locator": "Section 2.3, Observational studies and confounding variables, printed pp. 37–38"
        }
      ],
      "verification_status": "verified_directly"
    },
    {
      "id": "BIOEST-GLO-011",
      "term": "Pseudorreplicación",
      "definition": "Tratamiento incorrecto de mediciones o réplicas dependientes como si fueran unidades experimentales independientes, lo que exagera el tamaño muestral efectivo y la precisión aparente.",
      "unit_ids": [
        "BIOEST-U01"
      ],
      "source_ids": [
        "openintro-ims-2e"
      ],
      "source_locators": [
        {
          "source_id": "openintro-ims-2e",
          "locator": "Section 2.2, Experiments; pseudoreplication example, printed p. 34"
        }
      ],
      "verification_status": "verified_directly"
    },
    {
      "id": "BIOEST-GLO-012",
      "term": "Validez interna",
      "definition": "Grado en que la comparación o asociación estimada sustenta una inferencia creíble para las personas y condiciones estudiadas, considerando sesgos de selección, información y confusión.",
      "unit_ids": [
        "BIOEST-U01"
      ],
      "source_ids": [
        "strobe-statement-checklists"
      ],
      "source_locators": [
        {
          "source_id": "strobe-statement-checklists",
          "locator": "Checklist items 9 and 12: potential sources of bias and statistical control of confounding"
        }
      ],
      "verification_status": "verified_directly"
    },
    {
      "id": "BIOEST-GLO-013",
      "term": "Transportabilidad",
      "definition": "Posibilidad de aplicar una inferencia obtenida en la población y condiciones estudiadas a otra población, entorno o periodo, con base en similitudes relevantes y supuestos explícitos.",
      "unit_ids": [
        "BIOEST-U01"
      ],
      "source_ids": [
        "strobe-statement-checklists"
      ],
      "source_locators": [
        {
          "source_id": "strobe-statement-checklists",
          "locator": "Checklist item 21: generalisability (external validity) of the study results"
        }
      ],
      "verification_status": "verified_directly"
    },
    {
      "id": "BIOEST-GLO-014",
      "term": "Sesgo de información",
      "definition": "Distorsión sistemática de una asociación o distribución causada por errores en la medición, clasificación o registro de exposiciones, desenlaces u otras variables.",
      "unit_ids": [
        "BIOEST-U01"
      ],
      "source_ids": [
        "strobe-statement-checklists"
      ],
      "source_locators": [
        {
          "source_id": "strobe-statement-checklists",
          "locator": "Checklist items 7–9: variable definitions, measurement methods and efforts to address bias"
        }
      ],
      "verification_status": "verified_directly"
    },
