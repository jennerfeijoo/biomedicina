  "scope": "Afirmaciones centrales literales derivadas de las unidades curadas y enlazadas a fuentes del registro.",
  "review_state": "internal_curated_external_pending",
  "claims": [
    {
      "id": "INGTEJ-U01-CL01",
      "unit_id": "INGTEJ-U01",
      "text": "La función y el uso previsto preceden a la selección de células, materiales o señales.",
      "source_id": "tissue-engineering",
      "status": "curated_internal_review_pending"
    },
    {
      "id": "INGTEJ-U01-CL02",
      "unit_id": "INGTEJ-U01",
      "text": "Las células perciben y remodelan su entorno; la relación célula-matriz es bidireccional.",
      "source_id": "tissue-engineering-current-challenges-and-expanding-opportunities",
      "status": "curated_internal_review_pending"
    },
    {
      "id": "INGTEJ-U02-CL01",
      "unit_id": "INGTEJ-U02",
      "text": "Separar procedencia, estado celular y uso previsto evita categorías ambiguas.",
      "source_id": "standards-for-human-stem-cell-use-in-research",
      "status": "curated_internal_review_pending"
    },
    {
      "id": "INGTEJ-U02-CL02",
      "unit_id": "INGTEJ-U02",
      "text": "Identidad, fenotipo y función responden a preguntas diferentes.",
      "source_id": "basic-characterization",
      "status": "curated_internal_review_pending"
    },
    {
      "id": "INGTEJ-U03-CL01",
      "unit_id": "INGTEJ-U03",
      "text": "El uso previsto y la función requerida deben definirse antes de elegir la familia de biomaterial.",
      "source_id": "porous-scaffold-design-for-tissue-engineering",
      "status": "curated_internal_review_pending"
    },
    {
      "id": "INGTEJ-U03-CL02",
      "unit_id": "INGTEJ-U03",
      "text": "Porosidad, tamaño de poro, interconectividad y anisotropía son variables distintas.",
      "source_id": "biomaterials-scaffolds-for-tissue-engineering",
      "status": "curated_internal_review_pending"
    },
    {
      "id": "INGTEJ-U04-CL01",
      "unit_id": "INGTEJ-U04",
      "text": "El flujo difusivo depende del gradiente y de la difusividad, no solo de la concentración media.",
      "source_id": "vascularization-strategies-for-tissue-engineering",
      "status": "curated_internal_review_pending"
    },
    {
      "id": "INGTEJ-U04-CL02",
      "unit_id": "INGTEJ-U04",
      "text": "Caudal nominal, velocidad local y transporte efectivo son magnitudes diferentes.",
      "source_id": "the-role-of-perfusion-bioreactors-in-bone-tissue-engineering",
      "status": "curated_internal_review_pending"
    },
    {
      "id": "INGTEJ-U05-CL01",
      "unit_id": "INGTEJ-U05",
      "text": "La evaluación preclínica parte de una afirmación y un contexto de uso, no de una lista universal de ensayos.",
      "source_id": "iso-10993-1-2025-biological-evaluation-of-medical-devices-part-1",
      "status": "curated_internal_review_pending"
    },
    {
      "id": "INGTEJ-U05-CL02",
      "unit_id": "INGTEJ-U05",
      "text": "La unidad experimental determina qué cuenta como réplica independiente; campos, cortes o medidas repetidas no deben inflar n.",
      "source_id": "iso-10993-2-2022-animal-welfare-requirements",
      "status": "curated_internal_review_pending"
    },
    {
      "id": "INGTEJ-U06-CL01",
      "unit_id": "INGTEJ-U06",
      "text": "Definir producto y uso previsto antes de seleccionar controles.",
      "source_id": "fda-cmc-flexibilities-for-human-cellular-and-gene-therapy-products",
      "status": "curated_internal_review_pending"
    },
    {
      "id": "INGTEJ-U06-CL02",
      "unit_id": "INGTEJ-U06",
      "text": "Escalar exige conservar atributos, no multiplicar recetas.",
      "source_id": "ema-investigational-atmp-guideline",
      "status": "curated_internal_review_pending"
    }
  ]
}
