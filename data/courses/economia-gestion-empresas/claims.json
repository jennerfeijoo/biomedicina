{
  "$schema": "../../../schemas/academic/registry-v1.schema.json",
  "schema_version": "1.0",
  "course_id": "economia-gestion-empresas",
  "scope": "24 afirmaciones ancla, cuatro por unidad, conservadas literalmente desde el contenido lectivo y trazadas a fuentes directamente verificadas de cada unidad.",
  "review_state": "ai_review_provisional",
  "claims": [
    {
      "id": "EGE-C01-01",
      "unit": 1,
      "unit_id": "EGE-U01",
      "text": "Escasez significa incompatibilidad entre usos alternativos de recursos limitados, no simplemente falta de dinero.",
      "source_id": "ege-src-001",
      "source_verification_status": "verified_directly",
      "review_state": "ai_review_provisional",
      "support": "direct_or_methodological"
    },
    {
      "id": "EGE-C01-02",
      "unit": 1,
      "unit_id": "EGE-U01",
      "text": "Demanda y cantidad demandada no son sinónimos; precio mueve sobre la curva y otros determinantes pueden desplazarla.",
      "source_id": "ege-src-002",
      "source_verification_status": "verified_directly",
      "review_state": "ai_review_provisional",
      "support": "direct_or_methodological"
    },
    {
      "id": "EGE-C01-03",
      "unit": 1,
      "unit_id": "EGE-U01",
      "text": "Incertidumbre e información asimétrica limitan la interpretación de la atención sanitaria como un mercado competitivo simple.",
      "source_id": "ege-src-003",
      "source_verification_status": "verified_directly",
      "review_state": "ai_review_provisional",
      "support": "direct_or_methodological"
    },
    {
      "id": "EGE-C01-04",
      "unit": 1,
      "unit_id": "EGE-U01",
      "text": "Definir decisión, recurso limitante, alternativas factibles, horizonte y resultado antes de comparar.",
      "source_id": "ege-src-004",
      "source_verification_status": "verified_directly",
      "review_state": "ai_review_provisional",
      "support": "direct_or_methodological"
    },
    {
      "id": "EGE-C02-01",
      "unit": 2,
      "unit_id": "EGE-U02",
      "text": "Situación financiera es una fotografía a una fecha; resultados y flujos describen un periodo.",
      "source_id": "ege-src-010",
      "source_verification_status": "verified_directly",
      "review_state": "ai_review_provisional",
      "support": "direct_or_methodological"
    },
    {
      "id": "EGE-C02-02",
      "unit": 2,
      "unit_id": "EGE-U02",
      "text": "Directo/indirecto depende del objeto de coste y fijo/variable depende del comportamiento y rango relevante.",
      "source_id": "ege-src-011",
      "source_verification_status": "verified_directly",
      "review_state": "ai_review_provisional",
      "support": "direct_or_methodological"
    },
    {
      "id": "EGE-C02-03",
      "unit": 2,
      "unit_id": "EGE-U02",
      "text": "Flujos operativos, de inversión y financiación responden a fuentes distintas de cambios en efectivo.",
      "source_id": "ege-src-012",
      "source_verification_status": "verified_directly",
      "review_state": "ai_review_provisional",
      "support": "direct_or_methodological"
    },
    {
      "id": "EGE-C02-04",
      "unit": 2,
      "unit_id": "EGE-U02",
      "text": "Presupuesto operativo y presupuesto de caja responden a preguntas distintas y deben compartir supuestos coherentes.",
      "source_id": "ege-src-013",
      "source_verification_status": "verified_directly",
      "review_state": "ai_review_provisional",
      "support": "direct_or_methodological"
    },
    {
      "id": "EGE-C03-01",
      "unit": 3,
      "unit_id": "EGE-U03",
      "text": "Definir frontera, unidad de flujo y horizonte antes de comparar tasas o tiempos.",
      "source_id": "ege-src-020",
      "source_verification_status": "verified_directly",
      "review_state": "ai_review_provisional",
      "support": "direct_or_methodological"
    },
    {
      "id": "EGE-C03-02",
      "unit": 3,
      "unit_id": "EGE-U03",
      "text": "Turnaround time exige eventos de inicio y fin explícitos y constantes entre comparaciones.",
      "source_id": "ege-src-021",
      "source_verification_status": "verified_directly",
      "review_state": "ai_review_provisional",
      "support": "direct_or_methodological"
    },
    {
      "id": "EGE-C03-03",
      "unit": 3,
      "unit_id": "EGE-U03",
      "text": "Inventario equilibra continuidad frente a coste, espacio, obsolescencia y caducidad.",
      "source_id": "ege-src-022",
      "source_verification_status": "verified_directly",
      "review_state": "ai_review_provisional",
      "support": "direct_or_methodological"
    },
    {
      "id": "EGE-C03-04",
      "unit": 3,
      "unit_id": "EGE-U03",
      "text": "Rapidez es solo una dimensión; calidad operacional exige considerar trazabilidad, errores, retrabajos y otras consecuencias.",
      "source_id": "ege-src-023",
      "source_verification_status": "verified_directly",
      "review_state": "ai_review_provisional",
      "support": "direct_or_methodological"
    },
    {
      "id": "EGE-C04-01",
      "unit": 4,
      "unit_id": "EGE-U04",
      "text": "Segmentación de mercado agrupa clientes u organizaciones; no tiene relación con segmentar imágenes.",
      "source_id": "ege-src-031",
      "source_verification_status": "verified_directly",
      "review_state": "ai_review_provisional",
      "support": "direct_or_methodological"
    },
    {
      "id": "EGE-C04-02",
      "unit": 4,
      "unit_id": "EGE-U04",
      "text": "Usuario, comprador, pagador, decisor y beneficiario pueden ser actores diferentes.",
      "source_id": "ege-src-032",
      "source_verification_status": "verified_directly",
      "review_state": "ai_review_provisional",
      "support": "direct_or_methodological"
    },
    {
      "id": "EGE-C04-03",
      "unit": 4,
      "unit_id": "EGE-U04",
      "text": "La propuesta de valor debe especificar segmento, problema, beneficio, alternativa y evidencia.",
      "source_id": "ege-src-033",
      "source_verification_status": "verified_directly",
      "review_state": "ai_review_provisional",
      "support": "direct_or_methodological"
    },
    {
      "id": "EGE-C04-04",
      "unit": 4,
      "unit_id": "EGE-U04",
      "text": "Acceso regulatorio, HTA, adopción y gestión tecnológica son procesos distintos aunque relacionados.",
      "source_id": "ege-src-034",
      "source_verification_status": "verified_directly",
      "review_state": "ai_review_provisional",
      "support": "direct_or_methodological"
    },
    {
      "id": "EGE-C05-01",
      "unit": 5,
      "unit_id": "EGE-U05",
      "text": "La evaluación económica es comparativa: la selección del comparador forma parte del método.",
      "source_id": "ege-src-039",
      "source_verification_status": "verified_directly",
      "review_state": "ai_review_provisional",
      "support": "direct_or_methodological"
    },
    {
      "id": "EGE-C05-02",
      "unit": 5,
      "unit_id": "EGE-U05",
      "text": "El análisis debe ser incremental y conservar una dirección de comparación consistente.",
      "source_id": "ege-src-040",
      "source_verification_status": "verified_directly",
      "review_state": "ai_review_provisional",
      "support": "direct_or_methodological"
    },
    {
      "id": "EGE-C05-03",
      "unit": 5,
      "unit_id": "EGE-U05",
      "text": "Impacto presupuestario y coste-efectividad responden preguntas distintas.",
      "source_id": "ege-src-041",
      "source_verification_status": "verified_directly",
      "review_state": "ai_review_provisional",
      "support": "direct_or_methodological"
    },
    {
      "id": "EGE-C05-04",
      "unit": 5,
      "unit_id": "EGE-U05",
      "text": "Sensibilidad económica explora incertidumbre de parámetros y supuestos; no es sensibilidad diagnóstica.",
      "source_id": "ege-src-042",
      "source_verification_status": "verified_directly",
      "review_state": "ai_review_provisional",
      "support": "direct_or_methodological"
    },
    {
      "id": "EGE-C06-01",
      "unit": 6,
      "unit_id": "EGE-U06",
      "text": "Gobernanza define dirección, supervisión y accountability; gestión ejecuta dentro de autoridad delegada.",
      "source_id": "ege-src-046",
      "source_verification_status": "verified_directly",
      "review_state": "ai_review_provisional",
      "support": "direct_or_methodological"
    },
    {
      "id": "EGE-C06-02",
      "unit": 6,
      "unit_id": "EGE-U06",
      "text": "Un KPI debe estar vinculado a objetivo, definición, fuente, propietario, umbral y acción.",
      "source_id": "ege-src-047",
      "source_verification_status": "verified_directly",
      "review_state": "ai_review_provisional",
      "support": "direct_or_methodological"
    },
    {
      "id": "EGE-C06-03",
      "unit": 6,
      "unit_id": "EGE-U06",
      "text": "Riesgo se gestiona respecto de objetivos y escenarios, no mediante una puntuación universal aislada.",
      "source_id": "ege-src-048",
      "source_verification_status": "verified_directly",
      "review_state": "ai_review_provisional",
      "support": "direct_or_methodological"
    },
    {
      "id": "EGE-C06-04",
      "unit": 6,
      "unit_id": "EGE-U06",
      "text": "U6 integra U1–U5 mediante un sistema de supervisión y revisión, no mediante repetición de sus contenidos.",
      "source_id": "ege-src-049",
      "source_verification_status": "verified_directly",
      "review_state": "ai_review_provisional",
      "support": "direct_or_methodological"
    }
  ]
}
