      "verification_status": "traceable_to_curated_unit_sources"
    },
    {
      "id": "BMC-GLO-02-05",
      "term": "Tensión principal",
      "definition": "Valor propio de σ correspondiente a una dirección donde la tracción es puramente normal.",
