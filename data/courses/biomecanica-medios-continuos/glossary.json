      "verification_status": "traceable_to_curated_unit_sources"
    },
    {
      "id": "BMC-GLO-02-01",
      "term": "Tensor de tensiones de Cauchy",
      "definition": "Tensor σ que representa el estado local de fuerzas de contacto por área actual.",
