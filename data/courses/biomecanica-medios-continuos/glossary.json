        "BMC-U02"
      ],
      "source_ids": [
        "bmc-src-008"
      ],
      "verification_status": "traceable_to_curated_unit_sources"
    },
    {
      "id": "BMC-GLO-02-04",
      "term": "Tracción tangencial",
