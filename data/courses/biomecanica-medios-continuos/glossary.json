        "BMC-U02"
      ],
      "source_ids": [
        "bmc-src-008"
      ],
      "verification_status": "traceable_to_curated_unit_sources"
    },
    {
      "id": "BMC-GLO-02-06",
      "term": "Dirección principal",
      "definition": "Vector propio de σ asociado a una tensión principal.",
