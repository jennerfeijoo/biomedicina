        "bmc-src-008"
      ],
      "verification_status": "traceable_to_curated_unit_sources"
    },
    {
      "id": "BMC-GLO-02-02",
      "term": "Vector de tracción",
      "definition": "Fuerza por unidad de área que actúa sobre un plano de normal n; t(n)=σn.",
