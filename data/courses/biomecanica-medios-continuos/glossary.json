      "source_ids": [
        "bmc-src-009"
      ],
      "verification_status": "traceable_to_curated_unit_sources"
    },
    {
      "id": "BMC-GLO-02-11",
      "term": "Balance de momento angular",
      "definition": "Balance que en el continuo clásico sin pares internos implica simetría de σ.",
