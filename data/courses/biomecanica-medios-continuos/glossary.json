      "source_ids": [
        "bmc-src-019"
      ],
      "verification_status": "traceable_to_curated_unit_sources"
    },
    {
      "id": "BMC-GLO-03-24",
      "term": "Rango de validez",
      "definition": "Conjunto de deformaciones, cargas, escalas y condiciones para las que existe evidencia de desempeño aceptable.",
      "unit_ids": [
        "BMC-U03"
      ],
      "source_ids": [
        "bmc-src-002"
      ],
      "verification_status": "traceable_to_curated_unit_sources"
    },
    {
      "id": "BMC-GLO-04-01",
      "term": "Viscoelasticidad",
      "definition": "Respuesta material en la que esfuerzo y deformación dependen del tiempo o de la historia de carga además del estado actual.",
      "unit_ids": [
        "BMC-U04"
      ],
      "source_ids": [
        "bmc-src-028"
      ],
      "verification_status": "traceable_to_curated_unit_sources"
    },
    {
      "id": "BMC-GLO-04-02",
      "term": "Relajación de esfuerzo",
      "definition": "Disminución temporal del esfuerzo después de imponer y mantener una deformación aproximadamente constante.",
      "unit_ids": [
        "BMC-U04"
      ],
      "source_ids": [
        "bmc-src-028"
      ],
      "verification_status": "traceable_to_curated_unit_sources"
    },
    {
      "id": "BMC-GLO-04-03",
      "term": "Fluencia",
      "definition": "Aumento temporal de deformación bajo una carga o esfuerzo mantenido aproximadamente constante.",
      "unit_ids": [
        "BMC-U04"
      ],
      "source_ids": [
        "bmc-src-028"
      ],
      "verification_status": "traceable_to_curated_unit_sources"
    },
    {
      "id": "BMC-GLO-04-04",
      "term": "Histéresis",
      "definition": "Diferencia entre las trayectorias de carga y descarga asociada a disipación y dependencia de historia.",
      "unit_ids": [
        "BMC-U04"
      ],
      "source_ids": [
        "bmc-src-028"
      ],
      "verification_status": "traceable_to_curated_unit_sources"
    },
    {
      "id": "BMC-GLO-04-05",
      "term": "Resorte de Hooke",
      "definition": "Elemento ideal cuya respuesta lineal relaciona esfuerzo con deformación mediante un módulo elástico.",
      "unit_ids": [
        "BMC-U04"
      ],
      "source_ids": [
        "bmc-src-028"
      ],
      "verification_status": "traceable_to_curated_unit_sources"
    },
    {
      "id": "BMC-GLO-04-06",
      "term": "Amortiguador newtoniano",
      "definition": "Elemento ideal cuya respuesta relaciona esfuerzo con velocidad de deformación mediante una viscosidad.",
      "unit_ids": [
        "BMC-U04"
      ],
      "source_ids": [
        "bmc-src-028"
      ],
      "verification_status": "traceable_to_curated_unit_sources"
    },
    {
      "id": "BMC-GLO-04-07",
      "term": "Modelo de Maxwell",
      "definition": "Resorte y amortiguador en serie; captura relajación y flujo viscoso idealizado.",
      "unit_ids": [
        "BMC-U04"
      ],
      "source_ids": [
        "bmc-src-028"
      ],
      "verification_status": "traceable_to_curated_unit_sources"
    },
    {
      "id": "BMC-GLO-04-08",
      "term": "Modelo Kelvin–Voigt",
      "definition": "Resorte y amortiguador en paralelo; representa una fluencia retardada y recuperación asintótica.",
      "unit_ids": [
        "BMC-U04"
      ],
      "source_ids": [
        "bmc-src-028"
      ],
      "verification_status": "traceable_to_curated_unit_sources"
    },
    {
      "id": "BMC-GLO-04-09",
      "term": "Sólido lineal estándar",
      "definition": "Modelo viscoelástico con rigidez instantánea y de equilibrio y una escala principal de relajación.",
      "unit_ids": [
        "BMC-U04"
      ],
      "source_ids": [
        "bmc-src-028"
      ],
      "verification_status": "traceable_to_curated_unit_sources"
    },
    {
      "id": "BMC-GLO-04-10",
      "term": "Maxwell generalizado",
      "definition": "Conjunto de ramas Maxwell que permite representar múltiples escalas de relajación.",
      "unit_ids": [
        "BMC-U04"
      ],
      "source_ids": [
        "bmc-src-029"
      ],
      "verification_status": "traceable_to_curated_unit_sources"
    },
    {
      "id": "BMC-GLO-04-11",
      "term": "Serie de Prony",
      "definition": "Representación del módulo o función de relajación como suma ponderada de términos exponenciales.",
      "unit_ids": [
        "BMC-U04"
      ],
      "source_ids": [
        "bmc-src-028"
      ],
      "verification_status": "traceable_to_curated_unit_sources"
    },
    {
      "id": "BMC-GLO-04-12",
      "term": "Constante de tiempo",
      "definition": "Escala temporal característica de un proceso o rama del modelo; no implica por sí sola un mecanismo histológico único.",
      "unit_ids": [
        "BMC-U04"
      ],
      "source_ids": [
        "bmc-src-028"
      ],
      "verification_status": "traceable_to_curated_unit_sources"
    },
    {
      "id": "BMC-GLO-04-13",
      "term": "QLV",
      "definition": "Viscoelasticidad cuasilineal que combina una respuesta elástica no lineal con una función temporal reducida bajo supuestos de separabilidad.",
      "unit_ids": [
        "BMC-U04"
      ],
      "source_ids": [
        "bmc-src-028"
      ],
      "verification_status": "traceable_to_curated_unit_sources"
    },
    {
      "id": "BMC-GLO-04-14",
      "term": "Poroelasticidad",
      "definition": "Respuesta acoplada de un esqueleto poroso deformable y un fluido intersticial cuyo transporte contribuye a la dependencia temporal.",
      "unit_ids": [
        "BMC-U04"
      ],
      "source_ids": [
        "bmc-src-022"
      ],
      "verification_status": "traceable_to_curated_unit_sources"
    },
    {
      "id": "BMC-GLO-04-15",
      "term": "Modelo bipásico",
      "definition": "Modelo de mezcla con fase sólida y fase fluida acopladas, usado ampliamente para tejidos hidratados como cartílago.",
      "unit_ids": [
        "BMC-U04"
      ],
      "source_ids": [
        "bmc-src-022"
      ],
      "verification_status": "traceable_to_curated_unit_sources"
    },
    {
      "id": "BMC-GLO-04-16",
      "term": "Poroviscoelasticidad",
      "definition": "Modelo que combina transporte de fluido con viscoelasticidad intrínseca del esqueleto sólido.",
      "unit_ids": [
        "BMC-U04"
      ],
      "source_ids": [
        "bmc-src-026"
      ],
      "verification_status": "traceable_to_curated_unit_sources"
    },
    {
      "id": "BMC-GLO-04-17",
      "term": "Presión de poro",
      "definition": "Presión del fluido intersticial que contribuye a la tensión total y al transporte dentro del medio poroso.",
      "unit_ids": [
        "BMC-U04"
      ],
      "source_ids": [
        "bmc-src-022"
      ],
      "verification_status": "traceable_to_curated_unit_sources"
    },
    {
      "id": "BMC-GLO-04-18",
      "term": "Permeabilidad hidráulica",
      "definition": "Parámetro que cuantifica la facilidad de flujo inducido por gradiente de presión bajo una convención de unidades declarada.",
      "unit_ids": [
        "BMC-U04"
      ],
      "source_ids": [
        "bmc-src-022"
      ],
      "verification_status": "traceable_to_curated_unit_sources"
    },
    {
      "id": "BMC-GLO-04-19",
      "term": "Ley de Darcy",
      "definition": "Relación macroscópica entre flujo relativo y gradiente de presión en un medio poroso.",
      "unit_ids": [
        "BMC-U04"
      ],
      "source_ids": [
        "bmc-src-022"
      ],
      "verification_status": "traceable_to_curated_unit_sources"
    },
    {
      "id": "BMC-GLO-04-20",
      "term": "Drenaje",
      "definition": "Condición de frontera que determina si el fluido puede atravesar una superficie y condiciona la respuesta poroelástica.",
      "unit_ids": [
        "BMC-U04"
      ],
      "source_ids": [
        "bmc-src-022"
      ],
      "verification_status": "traceable_to_curated_unit_sources"
    },
    {
      "id": "BMC-GLO-04-21",
      "term": "Módulo instantáneo",
      "definition": "Rigidez efectiva asociada al límite temporal inicial de un modelo de relajación idealizado.",
      "unit_ids": [
        "BMC-U04"
      ],
      "source_ids": [
        "bmc-src-028"
      ],
      "verification_status": "traceable_to_curated_unit_sources"
    },
    {
      "id": "BMC-GLO-04-22",
      "term": "Módulo de equilibrio",
      "definition": "Rigidez efectiva correspondiente al estado relajado o de largo tiempo dentro del modelo y ensayo definidos.",
      "unit_ids": [
        "BMC-U04"
      ],
      "source_ids": [
        "bmc-src-028"
      ],
      "verification_status": "traceable_to_curated_unit_sources"
    },
    {
      "id": "BMC-GLO-04-23",
      "term": "Preacondicionamiento",
      "definition": "Ciclos previos de carga usados para reducir cambios transitorios de respuesta antes del ensayo principal; debe reportarse explícitamente.",
      "unit_ids": [
        "BMC-U04"
      ],
      "source_ids": [
        "bmc-src-026"
      ],
      "verification_status": "traceable_to_curated_unit_sources"
    },
    {
      "id": "BMC-GLO-04-24",
      "term": "Identificabilidad temporal",
      "definition": "Capacidad del protocolo para distinguir amplitudes y constantes de tiempo o parámetros de transporte sin combinaciones equivalentes.",
      "unit_ids": [
        "BMC-U04"
      ],
      "source_ids": [
        "bmc-src-029"
      ],
      "verification_status": "traceable_to_curated_unit_sources"
    },
    {
      "id": "BMC-GLO-05-01",
      "term": "Fluido incompresible",
      "definition": "Aproximación en la que la densidad material se mantiene constante y la velocidad satisface ∇·u=0.",
      "unit_ids": [
        "BMC-U05"
      ],
      "source_ids": [
        "bmc-src-004"
      ],
      "verification_status": "traceable_to_curated_unit_sources"
    },
    {
      "id": "BMC-GLO-05-02",
      "term": "Navier–Stokes",
      "definition": "Ecuaciones de conservación de cantidad de movimiento para un fluido continuo; requieren una ley constitutiva de esfuerzo y condiciones de frontera.",
      "unit_ids": [
        "BMC-U05"
      ],
      "source_ids": [
        "bmc-src-004"
      ],
      "verification_status": "traceable_to_curated_unit_sources"
    },
    {
      "id": "BMC-GLO-05-03",
      "term": "Caudal volumétrico",
      "definition": "Volumen de fluido que atraviesa una sección por unidad de tiempo, Q=∫A u·n dA.",
      "unit_ids": [
        "BMC-U05"
      ],
      "source_ids": [
        "bmc-src-004"
      ],
      "verification_status": "traceable_to_curated_unit_sources"
    },
    {
      "id": "BMC-GLO-05-04",
      "term": "Hagen–Poiseuille",
      "definition": "Solución analítica para flujo newtoniano estacionario, laminar y completamente desarrollado en un tubo circular rígido.",
      "unit_ids": [
        "BMC-U05"
      ],
      "source_ids": [
        "bmc-src-004"
      ],
      "verification_status": "traceable_to_curated_unit_sources"
    },
    {
      "id": "BMC-GLO-05-05",
      "term": "Número de Reynolds",
      "definition": "Razón adimensional entre escalas inerciales y viscosas basada en velocidad, longitud, densidad y viscosidad características.",
      "unit_ids": [
        "BMC-U05"
      ],
      "source_ids": [
        "bmc-src-004"
      ],
      "verification_status": "traceable_to_curated_unit_sources"
    },
    {
      "id": "BMC-GLO-05-06",
      "term": "Número de Womersley",
      "definition": "Parámetro adimensional que compara la escala temporal de oscilación con la difusión viscosa en flujo pulsátil.",
      "unit_ids": [
        "BMC-U05"
      ],
      "source_ids": [
        "bmc-src-034"
      ],
      "verification_status": "traceable_to_curated_unit_sources"
    },
    {
      "id": "BMC-GLO-05-07",
      "term": "Flujo pulsátil",
      "definition": "Flujo cuyas variables cambian de forma periódica o cuasiperiódica con el tiempo, como el flujo arterial.",
      "unit_ids": [
        "BMC-U05"
      ],
      "source_ids": [
        "bmc-src-034"
      ],
      "verification_status": "traceable_to_curated_unit_sources"
    },
    {
      "id": "BMC-GLO-05-08",
      "term": "Condición de no deslizamiento",
      "definition": "Condición en la que la velocidad del fluido coincide con la velocidad de una pared viscosa adherida.",
      "unit_ids": [
        "BMC-U05"
      ],
      "source_ids": [
        "bmc-src-034"
      ],
      "verification_status": "traceable_to_curated_unit_sources"
    },
    {
      "id": "BMC-GLO-05-09",
      "term": "Condición de entrada",
      "definition": "Información prescrita en una frontera de entrada, por ejemplo caudal, velocidad o perfil temporal.",
      "unit_ids": [
        "BMC-U05"
      ],
      "source_ids": [
        "bmc-src-034"
      ],
      "verification_status": "traceable_to_curated_unit_sources"
    },
    {
      "id": "BMC-GLO-05-10",
      "term": "Condición de salida",
      "definition": "Relación impuesta en una frontera de salida, como presión, caudal, resistencia o impedancia.",
      "unit_ids": [
        "BMC-U05"
      ],
      "source_ids": [
        "bmc-src-004"
      ],
      "verification_status": "traceable_to_curated_unit_sources"
    },
    {
      "id": "BMC-GLO-05-11",
      "term": "Esfuerzo cortante de pared",
      "definition": "Componente tangencial de la tracción fluida sobre una pared, derivada del campo de velocidades y de la reología.",
      "unit_ids": [
        "BMC-U05"
      ],
      "source_ids": [
        "bmc-src-034"
      ],
      "verification_status": "traceable_to_curated_unit_sources"
    },
    {
      "id": "BMC-GLO-05-12",
      "term": "TAWSS",
      "definition": "Promedio temporal de la magnitud del vector de esfuerzo cortante de pared durante un ciclo.",
      "unit_ids": [
        "BMC-U05"
      ],
      "source_ids": [
        "bmc-src-034"
      ],
      "verification_status": "traceable_to_curated_unit_sources"
    },
    {
      "id": "BMC-GLO-05-13",
      "term": "OSI",
      "definition": "Índice entre 0 y 0.5 que cuantifica cancelación direccional del WSS durante un ciclo bajo su definición estándar.",
      "unit_ids": [
        "BMC-U05"
      ],
      "source_ids": [
        "bmc-src-034"
      ],
      "verification_status": "traceable_to_curated_unit_sources"
    },
    {
      "id": "BMC-GLO-05-14",
      "term": "Viscosidad aparente",
      "definition": "Viscosidad efectiva inferida para una condición de corte; puede variar con tasa de corte en un fluido no newtoniano.",
      "unit_ids": [
        "BMC-U05"
      ],
      "source_ids": [
        "bmc-src-037"
      ],
      "verification_status": "traceable_to_curated_unit_sources"
    },
    {
      "id": "BMC-GLO-05-15",
      "term": "Shear thinning",
      "definition": "Comportamiento en el que la viscosidad aparente disminuye al aumentar la tasa de corte.",
      "unit_ids": [
        "BMC-U05"
      ],
      "source_ids": [
        "bmc-src-037"
      ],
      "verification_status": "traceable_to_curated_unit_sources"
    },
    {
      "id": "BMC-GLO-05-16",
      "term": "Hematocrito",
      "definition": "Fracción volumétrica de eritrocitos, uno de los determinantes de la reología sanguínea.",
      "unit_ids": [
        "BMC-U05"
      ],
      "source_ids": [
        "bmc-src-037"
      ],
      "verification_status": "traceable_to_curated_unit_sources"
    },
    {
      "id": "BMC-GLO-05-17",
      "term": "Carreau–Yasuda",
      "definition": "Modelo continuo que interpola viscosidad entre límites de bajo y alto corte mediante parámetros ajustables.",
      "unit_ids": [
        "BMC-U05"
      ],
      "source_ids": [
        "bmc-src-037"
      ],
      "verification_status": "traceable_to_curated_unit_sources"
    },
    {
      "id": "BMC-GLO-05-18",
      "term": "Recirculación",
      "definition": "Región donde las trayectorias o velocidades locales forman movimiento de retorno respecto del flujo principal.",
      "unit_ids": [
        "BMC-U05"
      ],
      "source_ids": [
        "bmc-src-004"
      ],
      "verification_status": "traceable_to_curated_unit_sources"
    },
    {
      "id": "BMC-GLO-05-19",
      "term": "Separación de flujo",
      "definition": "Desprendimiento de la capa cercana a una pared debido a geometría y gradientes adversos, generando flujo complejo aguas abajo.",
      "unit_ids": [
        "BMC-U05"
      ],
      "source_ids": [
        "bmc-src-004"
      ],
      "verification_status": "traceable_to_curated_unit_sources"
    },
    {
      "id": "BMC-GLO-05-20",
      "term": "Interacción fluido-estructura",
      "definition": "Acoplamiento en el que el flujo carga y deforma una estructura y la nueva geometría modifica a su vez el flujo.",
      "unit_ids": [
        "BMC-U05"
      ],
      "source_ids": [
        "bmc-src-045"
      ],
      "verification_status": "traceable_to_curated_unit_sources"
    },
    {
      "id": "BMC-GLO-05-21",
      "term": "Pared rígida",
      "definition": "Simplificación en la que el dominio sólido no se deforma por la presión o tracción del fluido.",
      "unit_ids": [
        "BMC-U05"
      ],
      "source_ids": [
        "bmc-src-004"
      ],
      "verification_status": "traceable_to_curated_unit_sources"
    },
    {
      "id": "BMC-GLO-05-22",
      "term": "Verificación",
      "definition": "Evaluación de si las ecuaciones y el método numérico se han implementado y resuelto correctamente.",
      "unit_ids": [
        "BMC-U05"
      ],
      "source_ids": [
        "bmc-src-045"
      ],
      "verification_status": "traceable_to_curated_unit_sources"
    },
    {
      "id": "BMC-GLO-05-23",
      "term": "Validación",
      "definition": "Evaluación de si el modelo representa suficientemente el sistema físico para un uso definido mediante comparación con evidencia apropiada.",
      "unit_ids": [
        "BMC-U05"
      ],
      "source_ids": [
        "bmc-src-045"
      ],
      "verification_status": "traceable_to_curated_unit_sources"
    },
    {
      "id": "BMC-GLO-05-24",
      "term": "Cuantificación de incertidumbre",
      "definition": "Propagación sistemática de incertidumbres de entrada o modelo hacia las salidas y conclusiones.",
      "unit_ids": [
        "BMC-U05"
      ],
      "source_ids": [
        "bmc-src-045"
      ],
      "verification_status": "traceable_to_curated_unit_sources"
    },
    {
      "id": "BMC-GLO-06-01",
      "term": "Método de elementos finitos",
      "definition": "Método numérico que aproxima un problema continuo mediante subdominios, funciones de forma y un conjunto finito de grados de libertad.",
      "unit_ids": [
        "BMC-U06"
      ],
      "source_ids": [
        "bmc-src-050"
      ],
      "verification_status": "traceable_to_curated_unit_sources"
    },
    {
      "id": "BMC-GLO-06-02",
      "term": "Formulación débil",
      "definition": "Forma integral del problema obtenida con funciones de prueba; reduce requisitos de derivabilidad y es base de muchas formulaciones FE.",
      "unit_ids": [
        "BMC-U06"
      ],
      "source_ids": [
        "bmc-src-050"
      ],
      "verification_status": "traceable_to_curated_unit_sources"
    },
    {
      "id": "BMC-GLO-06-03",
      "term": "Elemento",
      "definition": "Subdominio de la malla con una familia, orden, funciones de forma, integración y grados de libertad definidos.",
      "unit_ids": [
        "BMC-U06"
      ],
      "source_ids": [
        "bmc-src-050"
      ],
      "verification_status": "traceable_to_curated_unit_sources"
    },
    {
      "id": "BMC-GLO-06-04",
      "term": "Nodo",
      "definition": "Punto de la discretización en el que se almacenan o interpolan grados de libertad y que conecta elementos vecinos.",
      "unit_ids": [
        "BMC-U06"
      ],
      "source_ids": [
        "bmc-src-050"
      ],
      "verification_status": "traceable_to_curated_unit_sources"
    },
    {
      "id": "BMC-GLO-06-05",
      "term": "Grado de libertad",
      "definition": "Componente independiente resuelta por el sistema discreto, como desplazamiento, presión o temperatura según la física.",
      "unit_ids": [
        "BMC-U06"
      ],
      "source_ids": [
        "bmc-src-050"
      ],
      "verification_status": "traceable_to_curated_unit_sources"
    },
    {
      "id": "BMC-GLO-06-06",
      "term": "Función de forma",
      "definition": "Función usada para interpolar variables del elemento a partir de sus grados de libertad nodales.",
      "unit_ids": [
        "BMC-U06"
      ],
      "source_ids": [
        "bmc-src-050"
      ],
      "verification_status": "traceable_to_curated_unit_sources"
    },
    {
      "id": "BMC-GLO-06-07",
      "term": "Malla",
      "definition": "Conjunto de elementos y conectividad que discretiza la geometría y condiciona el espacio de aproximación numérica.",
      "unit_ids": [
        "BMC-U06"
      ],
      "source_ids": [
        "bmc-src-050"
      ],
      "verification_status": "traceable_to_curated_unit_sources"
    },
    {
      "id": "BMC-GLO-06-08",
      "term": "Calidad de malla",
      "definition": "Conjunto de métricas geométricas y numéricas de los elementos que pueden afectar precisión, estabilidad y comportamiento del solver.",
      "unit_ids": [
        "BMC-U06"
      ],
      "source_ids": [
        "bmc-src-050"
      ],
      "verification_status": "traceable_to_curated_unit_sources"
    },
    {
      "id": "BMC-GLO-06-09",
      "term": "Cantidad de interés",
      "definition": "Salida específica cuya exactitud y credibilidad importan para la pregunta y contexto de uso definidos.",
      "unit_ids": [
        "BMC-U06"
      ],
      "source_ids": [
        "bmc-src-052"
      ],
      "verification_status": "traceable_to_curated_unit_sources"
    },
    {
      "id": "BMC-GLO-06-10",
      "term": "h-refinement",
      "definition": "Refinamiento que reduce tamaño de elementos manteniendo esencialmente la familia/orden para estudiar error espacial.",
      "unit_ids": [
        "BMC-U06"
      ],
      "source_ids": [
        "bmc-src-050"
      ],
      "verification_status": "traceable_to_curated_unit_sources"
    },
    {
      "id": "BMC-GLO-06-11",
      "term": "p-refinement",
      "definition": "Refinamiento que aumenta el orden de interpolación para mejorar el espacio de aproximación sin necesariamente reducir tamaño.",
      "unit_ids": [
        "BMC-U06"
      ],
      "source_ids": [
        "bmc-src-050"
      ],
      "verification_status": "traceable_to_curated_unit_sources"
    },
    {
      "id": "BMC-GLO-06-12",
      "term": "Convergencia de malla",
      "definition": "Evidencia de que una cantidad de interés se aproxima a un valor límite al refinar sistemáticamente la discretización.",
      "unit_ids": [
        "BMC-U06"
      ],
      "source_ids": [
        "bmc-src-050"
      ],
      "verification_status": "traceable_to_curated_unit_sources"
    },
    {
      "id": "BMC-GLO-06-13",
      "term": "Singularidad",
      "definition": "Característica matemática donde una variable local puede crecer sin límite; hace inadecuado interpretar un máximo puntual como cantidad convergente.",
      "unit_ids": [
        "BMC-U06"
      ],
      "source_ids": [
        "bmc-src-050"
      ],
      "verification_status": "traceable_to_curated_unit_sources"
    },
    {
      "id": "BMC-GLO-06-14",
      "term": "Residual",
      "definition": "Desequilibrio entre términos del sistema algebraico que el solver intenta reducir durante una solución iterativa.",
      "unit_ids": [
        "BMC-U06"
      ],
      "source_ids": [
        "bmc-src-050"
      ],
      "verification_status": "traceable_to_curated_unit_sources"
    },
    {
      "id": "BMC-GLO-06-15",
      "term": "Verificación de código",
      "definition": "Evaluación de que la implementación del modelo matemático resuelve correctamente problemas de referencia.",
      "unit_ids": [
        "BMC-U06"
      ],
      "source_ids": [
        "bmc-src-050"
      ],
      "verification_status": "traceable_to_curated_unit_sources"
    },
    {
      "id": "BMC-GLO-06-16",
      "term": "Verificación de solución",
      "definition": "Evaluación de errores numéricos de una simulación concreta, incluidos discretización, iteración, balances y conservación.",
      "unit_ids": [
        "BMC-U06"
      ],
      "source_ids": [
        "bmc-src-050"
      ],
      "verification_status": "traceable_to_curated_unit_sources"
    },
    {
      "id": "BMC-GLO-06-17",
      "term": "Validación",
      "definition": "Evaluación de la capacidad predictiva mediante comparación con evidencia independiente relevante para un uso y cantidad de interés.",
      "unit_ids": [
        "BMC-U06"
      ],
      "source_ids": [
        "bmc-src-055"
      ],
      "verification_status": "traceable_to_curated_unit_sources"
    },
    {
      "id": "BMC-GLO-06-18",
      "term": "Calibración",
      "definition": "Estimación de parámetros del modelo mediante comparación con datos; no constituye por sí sola validación predictiva.",
      "unit_ids": [
        "BMC-U06"
      ],
      "source_ids": [
        "bmc-src-055"
      ],
      "verification_status": "traceable_to_curated_unit_sources"
    },
    {
      "id": "BMC-GLO-06-19",
      "term": "Aplicabilidad",
      "definition": "Correspondencia entre condiciones, magnitudes y dominio de la evidencia V&V y aquellos del contexto de uso propuesto.",
      "unit_ids": [
        "BMC-U06"
      ],
      "source_ids": [
        "bmc-src-050"
      ],
      "verification_status": "traceable_to_curated_unit_sources"
    },
    {
      "id": "BMC-GLO-06-20",
      "term": "Error de discretización",
      "definition": "Diferencia asociada a representar un problema continuo en un espacio finito y resolverlo con una malla/orden determinados.",
      "unit_ids": [
        "BMC-U06"
      ],
      "source_ids": [
        "bmc-src-050"
      ],
      "verification_status": "traceable_to_curated_unit_sources"
    },
    {
      "id": "BMC-GLO-06-21",
      "term": "Incertidumbre de entrada",
      "definition": "Variabilidad o conocimiento incompleto de geometría, cargas, propiedades, fronteras u otras entradas usadas por el modelo.",
      "unit_ids": [
        "BMC-U06"
      ],
      "source_ids": [
        "bmc-src-052"
      ],
      "verification_status": "traceable_to_curated_unit_sources"
    },
    {
      "id": "BMC-GLO-06-22",
      "term": "Análisis de sensibilidad",
      "definition": "Evaluación de cuánto cambia una cantidad de interés cuando cambian entradas, parámetros o supuestos del modelo.",
      "unit_ids": [
        "BMC-U06"
      ],
      "source_ids": [
        "bmc-src-052"
      ],
      "verification_status": "traceable_to_curated_unit_sources"
    },
    {
      "id": "BMC-GLO-06-23",
      "term": "Cuantificación de incertidumbre",
      "definition": "Caracterización y propagación de incertidumbres de entrada, parámetro, modelo y cálculo hacia las salidas.",
      "unit_ids": [
        "BMC-U06"
      ],
      "source_ids": [
        "bmc-src-052"
      ],
      "verification_status": "traceable_to_curated_unit_sources"
    },
    {
      "id": "BMC-GLO-06-24",
      "term": "Contexto de uso",
      "definition": "Descripción específica de cómo y para qué decisión se usará una predicción computacional y qué papel tendrá frente a otras evidencias.",
      "unit_ids": [
        "BMC-U06"
      ],
      "source_ids": [
        "bmc-src-055"
      ],
      "verification_status": "traceable_to_curated_unit_sources"
    },
    {
      "id": "BMC-GLO-06-25",
      "term": "Credibilidad del modelo",
      "definition": "Confianza basada en evidencia en la capacidad predictiva del modelo para el contexto de uso definido; no es una propiedad universal del archivo.",
      "unit_ids": [
        "BMC-U06"
      ],
      "source_ids": [
        "bmc-src-055"
      ],
      "verification_status": "traceable_to_curated_unit_sources"
    },
    {
      "id": "BMC-GLO-06-26",
      "term": "Influencia del modelo",
      "definition": "Grado en que la salida computacional contribuye a una decisión comparada con otras fuentes de evidencia.",
      "unit_ids": [
        "BMC-U06"
      ],
      "source_ids": [
        "bmc-src-055"
      ],
      "verification_status": "traceable_to_curated_unit_sources"
    },
    {
      "id": "BMC-GLO-06-27",
      "term": "Riesgo de decisión",
      "definition": "Combinación conceptual de influencia del modelo y consecuencias de que una decisión apoyada por el modelo sea incorrecta.",
      "unit_ids": [
        "BMC-U06"
      ],
      "source_ids": [
        "bmc-src-052"
      ],
      "verification_status": "traceable_to_curated_unit_sources"
    }
  ]
}
