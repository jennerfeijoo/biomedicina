{
  "$schema": "../../../schemas/academic/registry-v1.schema.json",
  "schema_version": "1.0",
  "course_id": "biomecanica-medios-continuos",
  "content_version": "1.0.0",
  "content_commit": "ccb01afaebe450b22168d608bfb0511e7fe488ad",
  "scope": "Cuatro afirmaciones metodológicas ancla por unidad, tomadas literalmente de los puntos clave del contenido canónico y vinculadas a una fuente de la sección.",
  "review_state": "internally_curated_external_review_pending",
  "claims": [
    {
      "id": "BMCONT-CLM-U01-01",
      "unit_id": "BMCONT-U01",
      "text": "La hipótesis de continuo es una decisión de escala, no una prueba de homogeneidad microscópica.",
      "source_id": "tool-tissue-continuum-review",
      "verification_status": "traceable_to_verified_source",
      "status": "internally_curated_external_review_pending"
    },
    {
      "id": "BMCONT-CLM-U01-02",
      "unit_id": "BMCONT-U01",
      "text": "F transforma elementos materiales y mezcla deformación con rotación local.",
      "source_id": "tool-tissue-continuum-review",
      "verification_status": "traceable_to_verified_source",
      "status": "internally_curated_external_review_pending"
    },
    {
      "id": "BMCONT-CLM-U01-03",
      "unit_id": "BMCONT-U01",
      "text": "C y E no atribuyen deformación a una rotación rígida superpuesta.",
      "source_id": "multiscale-mechanobiology",
      "verification_status": "traceable_to_verified_source",
      "status": "internally_curated_external_review_pending"
    },
    {
      "id": "BMCONT-CLM-U01-04",
      "unit_id": "BMCONT-U01",
      "text": "ρ₀=Jρ requiere ausencia explícita de fuentes y sumideros de masa.",
      "source_id": "growth-remodeling",
      "verification_status": "traceable_to_verified_source",
      "status": "internally_curated_external_review_pending"
    },
    {
      "id": "BMCONT-CLM-U02-01",
      "unit_id": "BMCONT-U02",
      "text": "La tracción depende del plano; el tensor σ reúne todas las tracciones posibles en un punto.",
      "source_id": "stress-living-tissues",
      "verification_status": "traceable_to_verified_source",
      "status": "internally_curated_external_review_pending"
    },
    {
      "id": "BMCONT-CLM-U02-02",
      "unit_id": "BMCONT-U02",
      "text": "Equilibrio es una ecuación de balance y no sustituye una ley constitutiva.",
      "source_id": "hemodynamics-continuum",
      "verification_status": "traceable_to_verified_source",
      "status": "internally_curated_external_review_pending"
    },
    {
      "id": "BMCONT-CLM-U02-03",
      "unit_id": "BMCONT-U02",
      "text": "El problema de equilibrio necesita fronteras suficientes y compatibles.",
      "source_id": "biaxial-boundary-conditions",
      "verification_status": "traceable_to_verified_source",
      "status": "internally_curated_external_review_pending"
    },
    {
      "id": "BMCONT-CLM-U02-04",
      "unit_id": "BMCONT-U02",
      "text": "Las medidas de tensión pertenecen a configuraciones distintas y no se comparan sin transformación.",
      "source_id": "residual-prestress",
      "verification_status": "traceable_to_verified_source",
      "status": "internally_curated_external_review_pending"
    },
    {
      "id": "BMCONT-CLM-U03-01",
      "unit_id": "BMCONT-U03",
      "text": "Balance y constitución son capas distintas del problema mecánico.",
      "source_id": "multiscale-mechanobiology",
      "verification_status": "traceable_to_verified_source",
      "status": "internally_curated_external_review_pending"
    },
    {
      "id": "BMCONT-CLM-U03-02",
      "unit_id": "BMCONT-U03",
      "text": "Isotropía es una simetría material, no una igualdad de todas las componentes de tensión o deformación.",
      "source_id": "isotropic-hyperelastic-review",
      "verification_status": "traceable_to_verified_source",
      "status": "internally_curated_external_review_pending"
    },
    {
      "id": "BMCONT-CLM-U03-03",
      "unit_id": "BMCONT-U03",
      "text": "La anisotropía debe vincularse a dirección o distribución estructural declarada.",
      "source_id": "hgo-arterial-framework",
      "verification_status": "traceable_to_verified_source",
      "status": "internally_curated_external_review_pending"
    },
    {
      "id": "BMCONT-CLM-U03-04",
      "unit_id": "BMCONT-U03",
      "text": "Ajuste excelente no demuestra unicidad de parámetros.",
      "source_id": "identifiability-uniaxial",
      "verification_status": "traceable_to_verified_source",
      "status": "internally_curated_external_review_pending"
    },
    {
      "id": "BMCONT-CLM-U04-01",
      "unit_id": "BMCONT-U04",
      "text": "Relajación mantiene deformación; fluencia mantiene carga o esfuerzo bajo la idealización del ensayo.",
      "source_id": "dortmans-qlv",
      "verification_status": "traceable_to_verified_source",
      "status": "internally_curated_external_review_pending"
    },
    {
      "id": "BMCONT-CLM-U04-02",
      "unit_id": "BMCONT-U04",
      "text": "Poroelasticidad introduce transporte intersticial además de deformación del esqueleto sólido.",
      "source_id": "mow-biphasic-1980",
      "verification_status": "traceable_to_verified_source",
      "status": "internally_curated_external_review_pending"
    },
    {
      "id": "BMCONT-CLM-U04-03",
      "unit_id": "BMCONT-U04",
      "text": "La misma relajación macroscópica puede surgir de mecanismos diferentes.",
      "source_id": "ateshian-poroviscoelastic",
      "verification_status": "traceable_to_verified_source",
      "status": "internally_curated_external_review_pending"
    },
    {
      "id": "BMCONT-CLM-U04-04",
      "unit_id": "BMCONT-U04",
      "text": "La ventana temporal debe cubrir las escalas que se quieren identificar.",
      "source_id": "sarver-qlv",
      "verification_status": "traceable_to_verified_source",
      "status": "internally_curated_external_review_pending"
    },
    {
      "id": "BMCONT-CLM-U05-01",
      "unit_id": "BMCONT-U05",
      "text": "Las ecuaciones de conservación requieren geometría y condiciones de frontera para producir una solución.",
      "source_id": "hemodynamics-continuum",
      "verification_status": "traceable_to_verified_source",
      "status": "internally_curated_external_review_pending"
    },
    {
      "id": "BMCONT-CLM-U05-02",
      "unit_id": "BMCONT-U05",
      "text": "Womersley incorpora la escala de pulsación que Reynolds no describe por sí solo.",
      "source_id": "womersley-theory-1955",
      "verification_status": "traceable_to_verified_source",
      "status": "internally_curated_external_review_pending"
    },
    {
      "id": "BMCONT-CLM-U05-03",
      "unit_id": "BMCONT-U05",
      "text": "La sangre no tiene una única viscosidad newtoniana universal en todos los regímenes y escalas.",
      "source_id": "blood-rheology-2019",
      "verification_status": "traceable_to_verified_source",
      "status": "internally_curated_external_review_pending"
    },
    {
      "id": "BMCONT-CLM-U05-04",
      "unit_id": "BMCONT-U05",
      "text": "FSI está justificada cuando la deformación de pared cambia materialmente la física relevante.",
      "source_id": "fsi-systematic-review",
      "verification_status": "traceable_to_verified_source",
      "status": "internally_curated_external_review_pending"
    },
    {
      "id": "BMCONT-CLM-U06-01",
      "unit_id": "BMCONT-U06",
      "text": "FEM aproxima una formulación física; no reemplaza la definición del modelo continuo.",
      "source_id": "asme-vv10",
      "verification_status": "traceable_to_verified_source",
      "status": "internally_curated_external_review_pending"
    },
    {
      "id": "BMCONT-CLM-U06-02",
      "unit_id": "BMCONT-U06",
      "text": "Verificación de código, verificación de solución y validación son capas diferentes.",
      "source_id": "asme-vv10",
      "verification_status": "traceable_to_verified_source",
      "status": "internally_curated_external_review_pending"
    },
    {
      "id": "BMCONT-CLM-U06-03",
      "unit_id": "BMCONT-U06",
      "text": "Calibración estima; validación prueba con evidencia no usada para estimar.",
      "source_id": "hicks-2015",
      "verification_status": "traceable_to_verified_source",
      "status": "internally_curated_external_review_pending"
    },
    {
      "id": "BMCONT-CLM-U06-04",
      "unit_id": "BMCONT-U06",
      "text": "Sensibilidad e incertidumbre no son sinónimos y deben conectarse antes de priorizar evidencia.",
      "source_id": "asme-vv40",
      "verification_status": "traceable_to_verified_source",
      "status": "internally_curated_external_review_pending"
    }
  ]
}
