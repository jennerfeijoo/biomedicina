      "source_verification_status": "verified_directly",
      "review_state": "ai_review_provisional",
      "support": "direct"
    },
    {
      "id": "LBI-C03-03",
      "unit": 3,
      "unit_id": "LBI-U03",
      "text": "Elegir ganancia a partir de señal máxima, offsets y margen, no solo de la señal mínima.",
