      "source_verification_status": "verified_directly",
      "review_state": "ai_review_provisional",
      "support": "direct"
    },
    {
      "id": "LBI-C01-04",
      "unit": 1,
      "unit_id": "LBI-U01",
      "text": "Registrar decisiones y desviaciones en el momento en que ocurren.",
      "source_id": "lbi-src-001",
      "source_verification_status": "verified_directly",
      "review_state": "ai_review_provisional",
      "support": "direct"
    },
    {
      "id": "LBI-C02-01",
      "unit": 2,
      "unit_id": "LBI-U02",
      "text": "La sensibilidad de un sensor es una relación entrada–salida con unidades, no sensibilidad diagnóstica.",
      "source_id": "lbi-src-011",
      "source_verification_status": "verified_directly",
      "review_state": "ai_review_provisional",
      "support": "direct"
    },
    {
      "id": "LBI-C02-02",
      "unit": 2,
      "unit_id": "LBI-U02",
      "text": "La histéresis necesita comparar trayectorias ascendente y descendente en el mismo valor de entrada.",
      "source_id": "lbi-src-011",
      "source_verification_status": "verified_directly",
      "review_state": "ai_review_provisional",
      "support": "direct"
    },
    {
      "id": "LBI-C02-03",
      "unit": 2,
      "unit_id": "LBI-U02",
      "text": "Caracterizar dinámica además de estática cuando la entrada cambia en escalas temporales relevantes.",
      "source_id": "lbi-src-011",
      "source_verification_status": "verified_directly",
      "review_state": "ai_review_provisional",
      "support": "direct"
    },
    {
      "id": "LBI-C02-04",
      "unit": 2,
      "unit_id": "LBI-U02",
      "text": "Predefinir el diseño antes de calcular métricas.",
      "source_id": "lbi-src-002",
      "source_verification_status": "verified_directly",
      "review_state": "ai_review_provisional",
      "support": "direct"
    },
    {
      "id": "LBI-C03-01",
      "unit": 3,
      "unit_id": "LBI-U03",
      "text": "Descomponer siempre las entradas en diferencial y modo común.",
      "source_id": "lbi-src-023",
      "source_verification_status": "verified_directly",
      "review_state": "ai_review_provisional",
      "support": "direct"
    },
    {
      "id": "LBI-C03-02",
      "unit": 3,
      "unit_id": "LBI-U03",
      "text": "CMRR alto reduce, pero no elimina, la respuesta a modo común.",
