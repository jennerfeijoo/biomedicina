      "source_verification_status": "verified_directly",
      "review_state": "ai_review_provisional",
      "support": "direct"
    },
    {
      "id": "LBI-C04-02",
      "unit": 4,
      "unit_id": "LBI-U04",
      "text": "La primera zona de Nyquist termina en f_s/2.",
