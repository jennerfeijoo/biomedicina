      "review_state": "ai_review_provisional",
      "support": "direct"
    },
    {
      "id": "LBI-C04-03",
      "unit": 4,
      "unit_id": "LBI-U04",
      "text": "Declarar rango del ADC y utilización del full-scale antes de interpretar códigos.",
