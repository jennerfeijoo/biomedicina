      "source_verification_status": "verified_directly",
      "review_state": "ai_review_provisional",
      "support": "direct"
    },
    {
      "id": "LBI-C03-04",
      "unit": 3,
      "unit_id": "LBI-U03",
      "text": "Referir ruido al mismo punto de la cadena y declarar la banda.",
      "source_id": "lbi-src-026",
      "source_verification_status": "verified_directly",
      "review_state": "ai_review_provisional",
      "support": "direct"
    },
    {
      "id": "LBI-C04-01",
      "unit": 4,
      "unit_id": "LBI-U04",
      "text": "Definir primero qué información debe preservarse; después elegir el filtro.",
