      "source_verification_status": "verified_directly",
      "review_state": "ai_review_provisional",
      "support": "direct"
    },
    {
      "id": "LBI-C04-04",
      "unit": 4,
      "unit_id": "LBI-U04",
      "text": "Conservar dato crudo y parámetros para reconstruir cada transformación.",
