      "review_state": "ai_review_provisional",
      "support": "direct"
    },
    {
      "id": "LBI-C01-02",
      "unit": 1,
      "unit_id": "LBI-U01",
      "text": "Definir el mensurando antes de seleccionar método e instrumento.",
      "source_id": "lbi-src-002",
      "source_verification_status": "verified_directly",
      "review_state": "ai_review_provisional",
      "support": "direct"
    },
    {
      "id": "LBI-C01-03",
      "unit": 1,
      "unit_id": "LBI-U01",
      "text": "Reportar un resultado junto con la incertidumbre pertinente al modelo y al uso.",
