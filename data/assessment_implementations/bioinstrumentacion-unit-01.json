  "feedback_contract": {
    "required_fields": [
      "diagnosed_misconception",
      "why_the_reasoning_fails",
      "first_hint",
      "second_hint",
      "source_or_section_to_review",
      "different_recovery_problem",
      "objective_continue_criterion"
    ],
    "release_by_attempt": {
      "1": ["diagnosed_misconception", "why_the_reasoning_fails", "first_hint", "source_or_section_to_review"],
      "2": ["diagnosed_misconception", "why_the_reasoning_fails", "second_hint", "source_or_section_to_review"],
      "3_plus": ["diagnosed_misconception", "why_the_reasoning_fails", "different_recovery_problem", "objective_continue_criterion", "source_or_section_to_review"]
    },
    "prohibited_output_fields": ["correct_category", "expected_decision", "answer_key", "complete_correct_response"]
  },
  "submission_contract": {
    "machine_scored": {
      "required": ["assessment_id", "attempt", "responses"],
      "concept_sort_response": "objeto item_id -> categoría seleccionada",
      "traceability_response": "objeto claim_id -> {decision, findings[]}"
    },
    "human_scored": {
      "required": ["assessment_id", "rubric_scores", "reviewer_notes"],
      "rule": "Las respuestas abiertas requieren puntuación humana contra la rúbrica; el motor solo valida estructura y calcula el resultado."
    }
  },
  "safety_boundary": "No se solicita adquisición con personas, interpretación clínica, diagnóstico ni decisión terapéutica.",
