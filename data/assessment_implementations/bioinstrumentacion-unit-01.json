      "mastery_rule": {
        "minimum_correct": 15,
        "critical_items_must_be_correct": true
      },
      "learner_output_policy": "El feedback no revela la categoría correcta; entrega diagnóstico y pistas graduadas."
    },
    {
      "id": "U1-A4",
      "type": "traceability_claim_review",
      "allowed_decisions": ["reject", "accept_limited"],
      "allowed_findings": [
        "subject_is_not_result",
        "chain_not_identified",
        "future_use_conditions_missing",
        "uncertainty_not_guarantee",
        "result_is_subject",
        "reference_identified",
        "chain_identified",
        "conditions_limited",
        "fitness_requires_context",
        "uncertainty_must_match_need"
      ],
      "claims": [
        {
          "id": "TR01",
          "statement": "El termómetro es trazable a una referencia nacional.",
          "expected_decision": "reject",
          "required_findings": ["subject_is_not_result", "chain_not_identified"],
          "misconceptions": ["instrument-is-traceable"]
        },
        {
          "id": "TR02",
          "statement": "El certificado vigente demuestra que todos los resultados futuros serán correctos.",
          "expected_decision": "reject",
          "required_findings": ["future_use_conditions_missing", "uncertainty_not_guarantee"],
          "misconceptions": ["certificate-guarantees-result"]
        },
        {
          "id": "TR03",
          "statement": "El resultado de 25,00 °C obtenido el 29 de julio de 2026 está relacionado con la referencia R mediante las calibraciones C1–C3, con incertidumbres documentadas, dentro del intervalo y condiciones declarados.",
          "expected_decision": "accept_limited",
          "required_findings": ["result_is_subject", "reference_identified", "chain_identified", "conditions_limited"],
          "misconceptions": ["instrument-is-traceable", "certificate-guarantees-result"]
        },
        {
          "id": "TR04",
          "statement": "Como el resultado es trazable, es adecuado para cualquier decisión clínica o técnica.",
          "expected_decision": "reject",
          "required_findings": ["fitness_requires_context", "uncertainty_must_match_need"],
          "misconceptions": ["traceability-means-fit"]
        }
      ],
      "mastery_rule": {
        "minimum_claims_fully_correct": 4,
        "critical_misconceptions_forbidden": ["instrument-is-traceable", "certificate-guarantees-result", "traceability-means-fit"]
      },
      "learner_output_policy": "El feedback no reproduce la decisión esperada ni la lista completa de hallazgos."
    }
  ],
  "human_scored_assessments": [
    {
      "id": "U1-A2",
      "type": "measurand_specification",
      "automatic_semantic_grading": false,
      "rubric": [
        {"criterion": "quantity_class", "max_points": 2, "critical_if_zero": true},
        {"criterion": "system_or_carrier", "max_points": 2, "critical_if_zero": true},
        {"criterion": "location", "max_points": 2, "critical_if_zero": false},
        {"criterion": "time_or_aggregation", "max_points": 2, "critical_if_zero": false},
        {"criterion": "state_and_conditions", "max_points": 2, "critical_if_zero": false},
        {"criterion": "unit_or_scale", "max_points": 2, "critical_if_zero": false},
        {"criterion": "method_dependency_justified", "max_points": 2, "critical_if_zero": false},
        {"criterion": "intended_use_and_inference_limit", "max_points": 2, "critical_if_zero": true}
      ],
      "mastery_rule": "Al menos 12/16 y ningún criterio crítico en cero.",
      "misconceptions": ["name-is-specification", "method-is-measurand", "analyte-equals-measurand"]
    },
    {
      "id": "U1-A3",
      "type": "measurement_chain_audit",
      "automatic_semantic_grading": false,
      "rubric": [
        {"criterion": "measurand_specified", "max_points": 2, "critical_if_zero": true},
        {"criterion": "system_boundary", "max_points": 2, "critical_if_zero": false},
        {"criterion": "signal_route", "max_points": 2, "critical_if_zero": false},
        {"criterion": "measurement_model_separate", "max_points": 2, "critical_if_zero": true},
        {"criterion": "influences_and_metadata", "max_points": 2, "critical_if_zero": false},
        {"criterion": "inference_limits", "max_points": 2, "critical_if_zero": true}
