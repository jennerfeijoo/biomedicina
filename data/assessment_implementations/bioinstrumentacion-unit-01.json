      "mastery_rule": "Al menos 9/12 y ningún criterio crítico en cero.",
      "misconceptions": ["chain-equals-model", "sensor-directly-measures-clinical-property", "metadata-irrelevant", "signal-equals-result"]
    },
    {
      "id": "U1-A5",
      "type": "transfer_case",
      "automatic_semantic_grading": false,
      "rubric": [
        {"criterion": "measurand_and_use", "max_points": 2, "critical_if_zero": true},
        {"criterion": "signal_chain", "max_points": 2, "critical_if_zero": false},
        {"criterion": "measurement_model", "max_points": 2, "critical_if_zero": true},
        {"criterion": "traceability_and_fitness", "max_points": 2, "critical_if_zero": true},
        {"criterion": "limitations_and_transfer", "max_points": 2, "critical_if_zero": false}
